{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Robot (simulated hardware)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["robot", "--sim"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Driver station → simulated robot",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["station", "--host", "localhost"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Driver station → Orange Pi",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["station"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Simulator + driver station",
      "configurations": ["Robot (simulated hardware)", "Driver station → simulated robot"],
      "stopAll": true
    }
  ]
}
